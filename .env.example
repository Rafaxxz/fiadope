# Copia este archivo como .env (no lo subas a git) y completa los valores.
DB_PASSWORD=una-clave-larga
JWT_SECRET=pega-aqui-48-caracteres-aleatorios-openssl-rand-base64-48
# true solo para demostraciones: la API devuelve el código MFA en la respuesta
MFA_DEV_ECHO=false
SEED_ENABLED=true
CORS_ORIGINS=http://localhost
WEB_PORT=80
# SMTP para el código MFA y los estados de cuenta (ej. Gmail con contraseña de aplicación)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

