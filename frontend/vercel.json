{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/fiadope-web/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://TU-API.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://TU-API.onrender.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

